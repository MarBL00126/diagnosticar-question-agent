# Development tasks. Needs only `python3` on PATH (and docker for docker-build and lock).
# Every Python tool runs from the project's virtualenv, created on first use.

PYTHON ?= python3
VENV ?= .venv
PY = $(VENV)/bin/python
STAMP = $(VENV)/.installed
IMAGE ?= diagnosticar-question-agent:dev
# The Dockerfile's base: the lock is resolved on the interpreter the image runs.
LOCK_IMAGE ?= python:3.12-slim
KB ?= data/kb.sqlite
# A local diagnostic.ar model service; override to point `make run` elsewhere.
PREGUNTAS_MODEL_SERVICE_URL ?= http://127.0.0.1:18021

.PHONY: install lint format format-check typecheck test test-live kb run docker-build lock ci

install: $(STAMP)

$(STAMP): pyproject.toml constraints.txt
	$(PYTHON) -m venv $(VENV)
	$(PY) -m pip install --quiet -e '.[dev]' -c constraints.txt
	touch $(STAMP)

lint: $(STAMP)
	$(PY) -m ruff check .

format: $(STAMP)
	$(PY) -m ruff check --fix --select I .
	$(PY) -m ruff format .

format-check: $(STAMP)
	$(PY) -m ruff format --check .

typecheck: $(STAMP)
	$(PY) -m mypy

test: $(STAMP)
	$(PY) -m pytest -m 'not live'

# Spends Claude quota and needs the claude CLI logged in.
test-live: $(STAMP)
	$(PY) -m pytest -m live

kb: $(STAMP)
	$(PY) -m diagnosticar_preguntas.kb.build --download --out $(KB)
	cat $(KB).sha256

# Local development only: no token, so unauthenticated calls must be allowed explicitly.
run: $(STAMP)
	PREGUNTAS_MODEL_SERVICE_URL='$(PREGUNTAS_MODEL_SERVICE_URL)' PREGUNTAS_ALLOW_UNAUTHENTICATED=true \
		$(PY) -m diagnosticar_preguntas.api

docker-build:
	docker build -t $(IMAGE) .

# Rewrites constraints.txt from a clean install of pyproject's runtime
# dependencies. Run it after changing them, or to move every pin forward.
lock:
	{ printf '%s\n' \
		'# Every runtime dependency, transitive ones included, as a clean install on' \
		'# $(LOCK_IMAGE) resolves them. The Dockerfile installs with -c constraints.txt.' \
		'# Generated by `make lock`; do not edit by hand.' \
	&& docker run --rm -v '$(CURDIR)/pyproject.toml:/tmp/pyproject.toml:ro' $(LOCK_IMAGE) sh -ec '\
		python -c "import tomllib; print(*tomllib.load(open(\"/tmp/pyproject.toml\", \"rb\"))[\"project\"][\"dependencies\"], sep=chr(10))" > /tmp/requirements.txt; \
		python -m venv /tmp/venv; \
		/tmp/venv/bin/pip install --quiet --disable-pip-version-check -r /tmp/requirements.txt; \
		/tmp/venv/bin/pip freeze'; \
	} > constraints.txt.new && mv constraints.txt.new constraints.txt || { rm -f constraints.txt.new; exit 1; }

ci: lint format-check typecheck test
