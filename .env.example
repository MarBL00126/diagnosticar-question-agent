# Configuration of the question agent. Copy to .env and uncomment what you change.
#
# PREGUNTAS_* variables are read from the environment or from .env in the
# working directory (the environment wins). Empty values count as unset. The
# commented values are the defaults.
#
# The LLM credentials at the end are read by the claude CLI and the Anthropic
# SDK from the process environment only, never from .env: export them in the
# shell, or pass the file to `docker run --env-file .env`.

# --- diagnostic.ar model service (POST /rank-genes) --------------------------
# `make run` sets this to http://127.0.0.1:18021 unless it is already exported.
# PREGUNTAS_MODEL_SERVICE_URL=http://localhost:8000
# Bounds the one model call of a round, on top of the round's budget below.
# PREGUNTAS_MODEL_SERVICE_TIMEOUT_S=10

# --- Knowledge base (built by `make kb`; baked into the image) --------------
# PREGUNTAS_KB_PATH=data/kb.sqlite

# --- LLM ----------------------------------------------------------------------
# claude-cli (Claude subscription through `claude -p`), anthropic (Claude API)
# or template (no LLM: deterministic wording, used for evaluation).
# PREGUNTAS_LLM_PROVIDER=claude-cli
# PREGUNTAS_LLM_MODEL=claude-opus-5
# Cap for one LLM call; a call never gets more than what is left of the round's budget.
# PREGUNTAS_LLM_TIMEOUT_S=60
# low, medium, high, xhigh or max.
# PREGUNTAS_LLM_EFFORT=high
# PREGUNTAS_LLM_QUESTION_EFFORT=medium

# --- Rounds -------------------------------------------------------------------
# Candidate symptoms the selector hands to the LLM per round.
# PREGUNTAS_SHORTLIST_SIZE=8
# At most 3 (the contract's limit).
# PREGUNTAS_QUESTIONS_PER_ROUND=3
# At most 3 (the contract's limit).
# PREGUNTAS_MAX_ROUNDS=3
# Stop asking when the top gene's refined score reaches this (0-1].
# PREGUNTAS_CONFIDENT_THRESHOLD=0.9
# Stop asking when no candidate symptom is worth this many bits.
# PREGUNTAS_MIN_INFORMATION_GAIN=0.05
# model_sees_present: every round the model ranks the findings reported before the
# questions plus every effective "sí". fixed_prior: it only ever ranks the reported
# findings and the answers act through the re-ranking below. See docs/DECISIONES.md, D-18.
# PREGUNTAS_RERANK_STRATEGY=model_sees_present
# How the agent reorders the model's genes. none: it does not; the ranking is the
# model's, and "no" answers and negated findings are only recorded. asymmetric: a
# disease moves only by what its annotations say about a finding (a "sí" it annotates
# x (1 + k*p), a "no" x (1 - k*p), a present finding it excludes x 0.02). calibrated:
# the full likelihood, where an unmentioned finding counts against a disease.
# See docs/EVALUACION.md, section 11.
# PREGUNTAS_ANSWER_WEIGHTING=none
# k of the asymmetric weighting, in [0, 1).
# PREGUNTAS_ANSWER_WEIGHT=0.3
# Seconds a round may spend on LLM calls. When too little is left for a call, the
# round uses template wording (or keeps the buttons as marked) and says so in warnings.
# The caller's timeout must exceed QUEUE_TIMEOUT_S + ROUND_BUDGET_S +
# MODEL_SERVICE_TIMEOUT_S (95 s with the defaults; the platform waits 100 s).
# PREGUNTAS_ROUND_BUDGET_S=75

# --- HTTP server ----------------------------------------------------------------
# PREGUNTAS_HOST=0.0.0.0
# PREGUNTAS_PORT=8010
# Shared secret the platform backend sends as X-Internal-Token. Without it the
# service refuses every round (401), unless PREGUNTAS_ALLOW_UNAUTHENTICATED=true,
# which is only acceptable for local development (`make run` sets it).
# PREGUNTAS_SERVICE_TOKEN=
# PREGUNTAS_ALLOW_UNAUTHENTICATED=false
# Rounds running at once, rounds allowed to wait, and how long each may wait
# before the API answers 503 busy.
# PREGUNTAS_MAX_CONCURRENT_ROUNDS=2
# PREGUNTAS_MAX_QUEUED_ROUNDS=4
# PREGUNTAS_QUEUE_TIMEOUT_S=10
# PREGUNTAS_LOG_LEVEL=INFO

# --- LLM credentials (process environment only) ---------------------------------
# claude-cli: a subscription token from `claude setup-token`. Locally, a
# `claude /login` session (~/.claude/.credentials.json) works too.
# CLAUDE_CODE_OAUTH_TOKEN=
# anthropic: a Claude API key. claude-cli also accepts it.
# ANTHROPIC_API_KEY=
# Path to the claude binary when it is not on PATH.
# CLAUDE_BINARY=
